// 露坑線上點餐 Worker（docs/44）。頂層＝staging；正式機用 `--env production`（§8.5：測試與正式完全分開）。
// 密鑰（INTEGRATION_SECRET）一律用 `wrangler secret put`，不寫在這裡、不進 repo。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lu-camp-online-order-staging",
  "main": "src/index.ts",
  "build": { "command": "pnpm build:client" },
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /t/<桌位碼> 等沒有對應檔案的路徑一律回點餐頁（index.html）。
    "not_found_handling": "single-page-application",
    // 動態路徑先進 Worker；點餐頁的靜態檔直接由資產服務（不計請求額度），安全標頭見 public/_headers。
    "run_worker_first": ["/api/*", "/integration/*", "/photos/*", "/fonts/*", "/tent-photos/*"]
  },
  "vars": { "STORE_ID": "1" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lu-camp-online-order-staging",
      "database_id": "1ca012e3-1610-438c-b42a-03efa69391b3",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "lu-camp-online-order-staging" }],
  "observability": { "enabled": true },
  "env": {
    // 正式版（2026-10-15 店主）：客人掃碼開 https://order.lukeng-camp.com。資料庫、照片、密鑰都跟測試版分開。
    // 密鑰 INTEGRATION_SECRET、TURNSTILE_SECRET 用 `wrangler secret put --env production`；
    // TURNSTILE_SITE_KEY 本來就會出現在客人頁上，不是密鑰。
    "production": {
      "name": "lu-camp-online-order",
      "workers_dev": false,
      "routes": [{ "pattern": "order.lukeng-camp.com", "custom_domain": true }],
      "vars": { "STORE_ID": "1", "TURNSTILE_SITE_KEY": "0x4AAAAAAFXnnokb3jQLwNnC" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lu-camp-online-order-production",
          "database_id": "66b0382d-8a16-4058-869f-54c321ec0717",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "lu-camp-online-order-production" }]
    }
  }
}
