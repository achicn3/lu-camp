# hardware-agent 環境變數範例（複製成 .env 後填入實際值；.env 不入 repo）
#
# 裝置 IP 一律由此處提供，程式碼內不寫死（CLAUDE.md：絕不可 hardcode 裝置 IP）。
# 建議在路由器以 DHCP 依「裝置 MAC」綁定固定 IP；日後 IP 變更時只需改這一處。

# 裝置注入模式：real = 真機（各台印表機與錢櫃皆走網路；未設 host 者維持 Fake、不列管）；
# fake = 不列印（自動化測試與無實機開發用）。**兩者都必須明寫**：未設或打錯字一律拒絕
# 啟動，不給預設值是刻意的——假裝模式會回報列印成功卻不出紙，靜默退化最難查。
AGENT_DEVICES=real

# 允許呼叫代理的前端來源（逗號分隔）。**必須列出前端實際的網址**：瀏覽器會擋下沒列到
# 的來源，症狀是列印全部失敗、而代理端連一行日誌都不會有。未設時預設只有
# http://localhost:3000；若前端從別的位址進來（WSL IP、區網主機名）就要一併列出。
AGENT_CORS_ORIGINS=http://localhost:3000

# 後端店家抬頭來源（收據/明細聯抬頭，見 agent/store_client.py）
AGENT_BACKEND_URL=http://localhost:8000

# 電子發票 QR 加密驗證資訊之 AES-128 金鑰（32 位 hex；由電子發票整合服務平台
# 「密碼及種子管理(QRCode)」產出，金鑰不入 repo）。未設時列印證明聯回 503。
# AGENT_EINVOICE_AES_KEY=
# AGENT_SERVICE_TOKEN=  # 後端服務對服務 token（如後端要求）

# --- 裝置連線（各台皆網路，A 級統一 TCP 9100 探測；見 docs/15、ADR-011、ADR-018）---

# EPSON TM-T82III 收據機（網路版）：收據／商品明細聯／收購憑證聯／出餐單
AGENT_EPSON_HOST=192.168.0.44
# AGENT_EPSON_PORT=9100        # 預設 9100（RAW/JetDirect）
# 中文字型編碼（預設 big5）。**必須與該台的字型 ROM 相符**，否則印出整捲亂碼。
# 查法：對該台 9100 送 `GS I 69`（1D 49 45），回 `TAIWAN BIG-5` → big5、
# `CHINA GB18030` → gbk。本店這台（S/N X7B4090696、fw 20.09）為 GB18030 機。見 ADR-018。
AGENT_EPSON_ENCODING=gbk

# Brother QL-810W 標籤/條碼機（網路版，**選配**：未設則標籤機維持 Fake、不列管；
# 有設即接真機並開始探測/送印，EPSON-only 部署請保持註解）
# 標籤紙：DK-22210（29mm 連續）。中文字型預設 repo 內建 Noto Sans TC（OFL）。
# AGENT_BROTHER_HOST=192.168.0.45
# AGENT_BROTHER_PORT=9100      # 預設 9100
# AGENT_LABEL_FONT=            # 標籤字型路徑（選填；預設 assets/fonts/NotoSansTC.ttf）

# EPSON TM-T82III 電子發票專屬機（**選配**；ADR-018）
# 未設 → 證明聯印到上面那台收據機（單機店家的既有行為，不會壞掉）。
# 有設 → 證明聯（含 Amego 補印的原樣版面）改印這台、並開始探測列管（狀態頁多一台 invoice-1）。
# 它**只印電子發票證明聯**，不印收據/明細聯/收購憑證聯/出餐單。
# 本店這台（S/N X7BJ020997、fw 15.05）為 TAIWAN BIG-5 機，故編碼維持預設 big5。
AGENT_INVOICE_HOST=192.168.0.42
# AGENT_INVOICE_PORT=9100      # 預設 9100
# AGENT_INVOICE_ENCODING=big5  # 預設 big5

# 錢櫃接在哪一台印表機的 drawer port（**選配**）
# 未設 → 沿用收據機（單機部署的既有行為）。有設 → kick 指令改送這台。
# 錢櫃只送指令、不出紙，故指到「發票專屬機」不違反該機的專屬定位。
# 本店實機：錢櫃的線插在發票機（192.168.0.42）那台。
AGENT_DRAWER_HOST=192.168.0.42
# AGENT_DRAWER_PORT=9100       # 預設 9100

# EPSON TM-T82III 出餐單機（第三台，**選配**；docs/35）
# 未設 → 出餐單印到上面那台收據機（單機店家的既有行為，不會壞掉）。
# 有設 → 出餐單改印這台、並開始探測列管（狀態頁多一台 kitchen-1）。
# **這台通常放廚房/吧台，沒人會看到它離線**，所以務必設定後確認 /devices/status 是 online。
# 它只印出餐單，不印收據/明細聯/證明聯。
# AGENT_KITCHEN_HOST=192.168.0.46
# AGENT_KITCHEN_PORT=9100      # 預設 9100
# AGENT_KITCHEN_ENCODING=big5  # 預設 big5；同樣須與該台字型 ROM 相符

# A 級 TCP 探測逾時（秒，各台共用；避免輪詢卡住 /devices/status）
# AGENT_DEVICE_PROBE_TIMEOUT=2.0
