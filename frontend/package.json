{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.4"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "_comment_test": "NODE_OPTIONS 關掉 Node 22.4+ 內建的實驗性全域 localStorage：沒給 --localstorage-file 時它是回傳 undefined 的 getter，而 vitest 的 jsdom 環境裡 window === globalThis，它會蓋掉 jsdom 自己的 localStorage，讓所有碰 localStorage 的測試炸在 undefined。此旗標必須在 Node 啟動時給（試過 vitest poolOptions.execArgv，無效），所以只能掛在這裡——請一律用 `pnpm test`，別直接跑 `vitest`。",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "smoke:timezone": "node scripts/timezone-smoke.mjs",
    "gen:api": "openapi-typescript openapi.json -o lib/api-types.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@tanstack/react-query": "^5.101.0",
    "gsap": "^3.15.0",
    "next": "16.2.7",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "jsdom": "^29.1.1",
    "jsqr": "^1.4.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
