# ── 環境變數範本（入庫；只放佔位值，禁止填真實金鑰/密碼）──
# 複製成 .env 後填本機開發值；.env 不入庫（見 .gitignore）。
# 正式環境的金鑰/密碼由部署環境或 KMS 注入，不寫進 repo。

# ── PostgreSQL（docker-compose 開發 DB 會讀這幾個）──
POSTGRES_USER=lucamp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lucamp

# ── 後端 ──
# 應用程式連線字串（asyncpg）。host/port 對應 compose 綁定的 127.0.0.1:1234。
DATABASE_URL=postgresql+asyncpg://lucamp:change-me@127.0.0.1:1234/lucamp
# development | test | production
APP_ENV=development

# ── 金鑰（禁止填真值入 repo；正式環境由部署/KMS 注入）──
# JWT 簽章金鑰（HS256；建議 >= 32 bytes 高熵）
SECRET_KEY=change-me-high-entropy
# PII 欄位加密金鑰：base64 of 32 bytes（AES-256-GCM）
#   產生：openssl rand -base64 32
PII_ENC_KEY=change-me-base64-32-bytes
# national_id blind-index 用 HMAC 金鑰（任意高熵字串）
#   產生：openssl rand -hex 32
HMAC_KEY=change-me-high-entropy

# ── 備份：Postgres 工具怎麼跑 ───────────────────────────────────────────────
# "docker"（預設）：資料庫跑在容器裡，備份走 docker exec 進容器跑 pg_dump（docs/28 原流程）。
# "local"        ：資料庫原生裝在本機（例：店內 MacBook 的 Homebrew postgresql@16），
#                  直接跑 pg_dump，連線參數與密碼取自 DATABASE_URL。
# 打錯字不會默默退回預設——組裝時就會失敗，因為「看起來有設定、每天靜默失敗」是備份最糟的結局。
BACKUP_PG_MODE=docker
# 僅 local 模式需要：pg_dump/pg_restore/psql 所在目錄。留空則用 PATH 上的，
# 但 launchd/systemd 的 PATH 未必包含 Homebrew，正式機建議明確指定。
BACKUP_PG_BIN_DIR=
# 備份檔落地目錄（明文 dump 會短暫存在此處，權限 700/600）。
BACKUP_LOCAL_DIR=/var/lib/lucamp-backups
